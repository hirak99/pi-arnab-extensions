{
  "name": "pi-background-jobs",
  "version": "0.1.0",
  "description": "Focused background shell jobs for Pi with reload-preserving processes, durable logs, completion notifications, a footer, and Discord Remote integration.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "dependencies": {
    "pi-durable-inbox": "*",
    "pi-output-store": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.0.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
